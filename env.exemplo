# Ambiente da API: development, test ou production
NODE_ENV=development

# Porta utilizada pelo servidor
PORT=4567

# Gere valores aleatórios fortes para sua instalação. Não reutilize valores de exemplo.
JWT_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_FORTE_AQUI
JWT_EXPIRES_IN=1h
SESSION_SECRET=COLOQUE_OUTRO_SEGREDO_ALEATORIO_FORTE_AQUI

# OAuth do GitHub (opcional). Obtenha estes dados nas configurações de uma GitHub OAuth App.
GITHUB_CLIENT_ID=SEU_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=SEU_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:4567/auth/github/callback

# SQLite: se ficar comentado, o projeto usa ./Database/database.sqlite automaticamente.
# DB_STORAGE=./Database/database.sqlite

# PRIVATE_KEY é aceita apenas por compatibilidade com versões antigas; prefira JWT_SECRET.
# PRIVATE_KEY=
